# Copy to .env and fill in values from Supabase Dashboard → Settings → API.
# Use VITE_EXT_* so Lovable does not override with its default Supabase project.

VITE_EXT_SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
VITE_EXT_SUPABASE_ANON_KEY="sb_publishable_P8s5LPIKyxYxM9UUwthePA_j12HHtet"
VITE_BACKEND_URL="http://localhost:8000"

# Backend only (Render / local uvicorn) — never expose as VITE_*.
# SUPABASE_JWT_SECRET = JWT Secret from Supabase → Project Settings → API (for verifying user access tokens).
# RESEND_API_KEY / RESEND_FROM = https://resend.com
# SMS Everyone: https://www.smseveryone.co.nz/api — optional SMS_EVERYONE_SEND_URL if your account uses a different host.
# SUPABASE_JWT_SECRET=""
# RESEND_API_KEY=""
# RESEND_FROM="Your Business <quotes@yourdomain.com>"
# SMS_EVERYONE_USERNAME=""
# SMS_EVERYONE_PASSWORD=""
# SMS_EVERYONE_ORIGINATOR=""
# SMS_EVERYONE_SEND_URL="https://smseveryone.com/api/campaign"
